{
    "⚙️ Process Management": [
        [
            "ps aux",
            "Process list"
        ],
        [
            "ps | grep enigma2",
            "Enigma2 processes"
        ],
        [
            "killall -9 enigma2",
            "Kill Enigma2 (restart GUI)"
        ],
        [
            "killall -9 python",
            "Kill all Python processes"
        ],
        [
            "killall -INT ffmpeg",
            "Stop ffmpeg"
        ],
        [
            "top -n 1 -b",
            "Real-time processes (one shot)"
        ],
        [
            "lsof | wc -l",
            "Count open files"
        ]
    ],
    "🌐 Network": [
        [
            "ifconfig",
            "Network configuration"
        ],
        [
            "ip link",
            "Network interfaces"
        ],
        [
            "ip route | grep default",
            "Default gateway"
        ],
        [
            "netstat -tulpn",
            "Listening ports"
        ],
        [
            "ping -c 1 8.8.8.8",
            "Ping Google DNS"
        ],
        [
            "wget -q -T 1 -t 1 --spider http://www.google.com",
            "HTTP connectivity test"
        ],
        [
            "arp -n",
            "ARP table"
        ],
        [
            "hostname -I",
            "Local IP addresses"
        ]
    ],
    "🎬 Media/Streaming": [
        [
            "ffmpeg -version | head -1",
            "FFmpeg version"
        ],
        [
            "ffmpeg -i /media/hdd/movie/recording.ts -frames:v 1 screenshot.jpg",
            "Extract screenshot from video"
        ],
        [
            "showiframe /usr/share/enigma2/backdrop.mvi",
            "Show MVI bootlogo"
        ],
        [
            "killall -INT ffmpeg",
            "Stop running ffmpeg"
        ]
    ],
    "📁 System Info": [
        [
            "uname -a",
            "Kernel information"
        ],
        [
            "uptime",
            "System uptime"
        ],
        [
            "free -m",
            "Free memory (MB)"
        ],
        [
            "cat /proc/meminfo",
            "Memory details"
        ],
        [
            "df -h",
            "Disk space usage"
        ],
        [
            "df -aTh",
            "Disk space with FS type"
        ],
        [
            "blkid",
            "Block device UUIDs"
        ],
        [
            "cat /proc/cpuinfo",
            "CPU info"
        ],
        [
            "cat /proc/version",
            "Kernel version"
        ],
        [
            "hostname",
            "Hostname"
        ],
        [
            "who -a",
            "Logged users"
        ],
        [
            "lsof",
            "Open files (may take time)"
        ]
    ],
    "📂 Filesystem": [
        [
            "ls -la /etc/enigma2/",
            "Content of /etc/enigma2"
        ],
        [
            "pwd",
            "Current directory"
        ],
        [
            "cd /tmp && ls -la",
            "Content of /tmp"
        ],
        [
            "find /etc/enigma2 -name '*.tv'",
            "Find TV bouquets"
        ],
        [
            "du -shc /home/root 2>/dev/null",
            "Space used by /home/root"
        ],
        [
            "mount",
            "Mount points"
        ],
        [
            "cat /etc/fstab",
            "Filesystem table"
        ],
        [
            "lsattr -d /etc",
            "Attributes of /etc"
        ]
    ],
    "📦 Package Management": [
        [
            "opkg update",
            "Update package list (opkg)"
        ],
        [
            "opkg list-installed",
            "Installed packages (opkg)"
        ],
        [
            "opkg list | head -20",
            "First 20 available packages"
        ],
        [
            "opkg install <name>",
            "Install package (replace <name>)"
        ],
        [
            "opkg remove <name>",
            "Remove package"
        ],
        [
            "apt-get update",
            "Update (apt)"
        ],
        [
            "apt list --installed | head -20",
            "Installed apt packages"
        ],
        [
            "dpkg -l | head -20",
            "dpkg list"
        ]
    ],
    "📦 Package Search (opkg)": [
        [
            "opkg update",
            "Update package list"
        ],
        [
            "opkg list | grep -i ssl",
            "Search SSL packages"
        ],
        [
            "opkg list | grep -i dvbcsa",
            "Search dvbcsa packages"
        ],
        [
            "opkg list | grep -i pcsc",
            "Search pcsc packages"
        ],
        [
            "opkg list-installed | grep -i ssl",
            "Installed SSL packages"
        ],
        [
            "opkg list-installed | grep -i pcsc",
            "Installed pcsc packages"
        ],
        [
            "openssl version",
            "OpenSSL version"
        ],
        [
            "ls -l /usr/lib/libss*.*",
            "Find SSL library"
        ],
        [
            "opkg install libcrypto-compat",
            "Install libcrypto-compat"
        ]
    ],
    "📸 Screenshot": [
        [
            "grab -q -s jpg > /tmp/screenshot.jpg",
            "Screenshot JPG"
        ],
        [
            "grab -p -s png > /tmp/screenshot.png",
            "Screenshot PNG"
        ],
        [
            "dreamboxctl screenshot -f /tmp/screen.png",
            "Screenshot using dreamboxctl"
        ]
    ],
    "🔗 Symlink & Architecture": [
        [
            "ln -sf /usr/lib/enigma2/python/Plugins/Extensions/ /",
            "Create symlink Extensions"
        ],
        [
            "ln -sf /usr/share/enigma2/ /",
            "Create symlink share"
        ],
        [
            "TARGET=$(find /media -maxdepth 1 -type d ! -name 'media' -exec mountpoint -q {} \\; -print | head -n 1) && [ -n \"$TARGET\" ] && ln -sf \"$TARGET\" /hdd && ln -sf \"$TARGET/picon\" /usr/share/enigma2/picon && ln -sf \"$TARGET/picon\" /picon && echo \"Created for: $TARGET\"",
            "Auto-create symlinks for HDD/picon"
        ],
        [
            "dpkg --print-architecture | grep -iE 'arm|aarch64|mips|cortex|sh4|sh_4'",
            "Box architecture (dpkg)"
        ],
        [
            "opkg print-architecture | grep -iE 'arm|aarch64|mips|cortex|h4|sh_4'",
            "Box architecture (opkg)"
        ]
    ],
    "🔧 OSCam Tools": [
        [
            "find /usr/bin -name 'oscam*' -type f",
            "Search oscam files in /usr/bin"
        ],
        [
            "ls -la /usr/bin/oscam*",
            "List oscam files details"
        ],
        [
            "find /usr/bin -name 'oscam*' -type f 2>/dev/null",
            "Recursive oscam search"
        ],
        [
            "find /usr/bin -name 'oscam*' -o -name '*oscam*' -type f 2>/dev/null",
            "Extended wildcard oscam search"
        ],
        [
            "find /usr/bin -name 'oscam*' -type f 2>/dev/null | wc -l",
            "Count oscam files found"
        ],
        [
            "ps aux | grep oscam | grep -v grep",
            "Check if oscam is running"
        ],
        [
            "find / -name '*oscam*' -type f 2>/dev/null | head -20",
            "Search oscam everywhere (slow)"
        ],
        [
            "find /usr/bin -name '*oscam*' -type f -exec file {} \\;",
            "Find oscam scripts"
        ],
        [
            "find /usr/bin -name 'oscam*' -type f -executable",
            "Find oscam executables"
        ]
    ],
    "📡 OSCam Management": [
        [
            "D=$(date +\"%d.%m.%Y\"); mkdir -p /etc/tuxbox/config/backup_files-$D; cp /etc/tuxbox/config/oscam.* /etc/tuxbox/config/backup_files-$D/ 2>/dev/null",
            "Backup OSCam configuration (with date)"
        ],
        [
            "echo '' > /tmp/oscam.log",
            "Clear OScam log"
        ],
        [
            "rm -f /etc/tuxbox/config/oscam.ccache",
            "Clear ICAM cache"
        ],
        [
            "rm -f /etc/tuxbox/config/*.emmstat /etc/tuxbox/config/*.emmcache",
            "Delete EMM statistics"
        ],
        [
            "ping -c 2 dns2eu.com",
            "Ping ICAM server (dns2eu.com)"
        ],
        [
            "wget --no-check-certificate -U 'Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/70.0.3538.77 Safari/537.36' -O /etc/tuxbox/config/softcam.key https://raw.githubusercontent.com/MOHAMED19OS/SoftCam_Emu/main/SoftCam.Key 2>/dev/null",
            "Download latest softcam.key from Mohamed19OS"
        ],
        [
            "grep -q '\\[account\\]' /etc/tuxbox/config/oscam.conf && echo 'WARNING: Account in oscam.conf!' || echo 'Syntax OK!'",
            "Check OScam config syntax"
        ],
        [
            "chmod -R 755 /etc/tuxbox/config/script/",
            "Fix OScam script permissions"
        ],
        [
            "tail -n 30 /tmp/oscam.log 2>/dev/null",
            "Show last 30 lines of OScam log"
        ],
        [
            "grep -E 'label|enable|protocol|device' /etc/tuxbox/config/oscam.server",
            "Show OScam reader status"
        ],
        [
            "killall -9 streamproxy wget curl 2>/dev/null",
            "Resolve IPTV stream blocks"
        ]
    ],
    "📡 Common Interface": [
        [
            "/etc/init.d/ciplushelper start",
            "Start CI+ helper daemon"
        ],
        [
            "/etc/init.d/ciplushelper stop",
            "Stop CI+ helper daemon"
        ],
        [
            "killall ciplushelper 2>/dev/null",
            "Force kill CI+ helper"
        ],
        [
            "pgrep ciplushelper",
            "Check if CI+ helper is running"
        ],
        [
            "ln -sf /etc/init.d/ciplushelper /etc/rc2.d/S50ciplushelper && ln -sf /etc/init.d/ciplushelper /etc/rc3.d/S50ciplushelper && ln -sf /etc/init.d/ciplushelper /etc/rc4.d/S50ciplushelper && ln -sf /etc/init.d/ciplushelper /etc/rc5.d/S50ciplushelper",
            "Enable CI+ helper autostart"
        ],
        [
            "rm -f /etc/rc2.d/S50ciplushelper /etc/rc3.d/S50ciplushelper /etc/rc4.d/S50ciplushelper /etc/rc5.d/S50ciplushelper",
            "Disable CI+ helper autostart"
        ],
        [
            "cp -R /usr/lib/enigma2/python/Plugins/Extensions/Ciplushelper/ciplus /etc/ciplus",
            "Install CI+ certificates (copy /etc/ciplus)"
        ],
        [
            "rm -rf /etc/ciplus",
            "Remove CI+ certificates (/etc/ciplus)"
        ],
        [
            "mv /etc/ciplus0_enable /etc/ciplus0_disable",
            "Disable CI+ slot 0"
        ],
        [
            "mv /etc/ciplus0_disable /etc/ciplus0_enable",
            "Enable CI+ slot 0"
        ],
        [
            "mv /etc/ciplus1_enable /etc/ciplus1_disable",
            "Disable CI+ slot 1"
        ],
        [
            "mv /etc/ciplus1_disable /etc/ciplus1_enable",
            "Enable CI+ slot 1"
        ],
        [
            "cp /usr/lib/enigma2/python/Plugins/Extensions/Ciplushelper/cicert.bin /etc/cicert.bin",
            "Install cicert.bin (Zgemma specific)"
        ],
        [
            "[ ! -f /etc/ciplus0_enable ] && echo 'rename ciplus*_enable to ciplus*_disable for deactivate ciplus certification of the module.' > /etc/ciplus0_enable",
            "Create enable file for slot 0 (if missing)"
        ],
        [
            "[ ! -f /etc/ciplus1_enable ] && echo 'rename ciplus*_enable to ciplus*_disable for deactivate ciplus certification of the module.' > /etc/ciplus1_enable",
            "Create enable file for slot 1 (if missing)"
        ],
        [
            "cp /usr/lib/enigma2/python/Plugins/Extensions/Ciplushelper/ciplushelper_bin/zgemma-arm/ciplushelper /usr/bin/ciplushelper && chmod 755 /usr/bin/ciplushelper",
            "Install Zgemma ARM binary (with cicert.bin support)"
        ],
        [
            "cp /usr/lib/enigma2/python/Plugins/Extensions/Ciplushelper/ciplushelper_bin/arm/ciplushelper /usr/bin/ciplushelper && chmod 755 /usr/bin/ciplushelper",
            "Install default ARM binary"
        ],
        [
            "cp /usr/lib/enigma2/python/Plugins/Extensions/Ciplushelper/ciplushelper.sh /etc/init.d/ciplushelper && chmod 755 /etc/init.d/ciplushelper",
            "Update CI+ helper init script"
        ],
        [
            "wget -q --no-check-certificate https://raw.githubusercontent.com/OwnerPlugins/Ciplushelper/main/installer.sh -O - | /bin/bash",
            "Update CI+ helper plugin (online installer)"
        ]
    ],
    "🕹️ Enigma2 Specific": [
        [
            "wget -qO- http://127.0.0.1/web/servicelistreload",
            "Reload channel list (webif)"
        ],
        [
            "init 3",
            "Restart GUI (alternative)"
        ],
        [
            "systemctl restart enigma2",
            "Restart GUI (systemd)"
        ],
        [
            "grep -i 'error' /home/root/.enigma2/enigma2.log | tail -20",
            "Last Enigma2 errors"
        ]
    ],
